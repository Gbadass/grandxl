{
  "name": "@grandxl/types",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript interfaces, enums, and constants shared across all GrandXL apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@grandxl/config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
