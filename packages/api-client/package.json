{
  "name": "@grandxl/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed async API call functions shared across web, admin, and mobile apps. NOT hooks — each app wraps in TanStack Query locally.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@grandxl/config": "workspace:*",
    "@grandxl/types": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@grandxl/types": "workspace:*"
  }
}
