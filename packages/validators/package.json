{
  "name": "@grandxl/validators",
  "version": "1.0.0",
  "private": true,
  "description": "Zod validation schemas shared across all GrandXL apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grandxl/types": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@grandxl/config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
